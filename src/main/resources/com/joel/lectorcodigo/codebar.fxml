<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.joel.lectorcodigo.CodeBarraController">
    <left>
        <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="300.0" BorderPane.alignment="CENTER">
            <children>
                <AnchorPane prefHeight="200.0" prefWidth="200.0">
                    <children>
                        <TextField fx:id="txtBuscar" layoutX="73.0" layoutY="15.0" maxWidth="-Infinity"
                                   onKeyReleased="#onFiltrarCodeBar"/>
                        <Label layoutX="15.0" layoutY="18.0" text="Buscar:"/>
                        <Button layoutX="78.0" layoutY="100.0" mnemonicParsing="false" text="VERSION 1.0.4"/>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                    </padding>
                </AnchorPane>
                <AnchorPane prefHeight="200.0" prefWidth="200.0"
                            style="-fx-border-style: dashed; -fx-border-color: #8B4513 transparent transparent   transparent;"/>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
        </VBox>
    </left>
    <top>
        <VBox alignment="CENTER" prefHeight="191.0" prefWidth="1000.0" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <HBox alignment="CENTER" prefHeight="177.0" prefWidth="940.0">
                <children>
                    <AnchorPane maxWidth="-Infinity" prefHeight="100.0" prefWidth="240.0"
                                style="-fx-border-color: #8B4513 transparent #8B4513  transparent; -fx-border-style: dashed;">
                        <children>
                            <Label layoutX="7.0" layoutY="21.0" text="Codigo:"/>
                            <Label layoutX="7.0" layoutY="59.0" text="Producto:"/>
                            <TextField fx:id="txtCodigo" layoutX="69.0" layoutY="17.0"/>
                            <TextField fx:id="txtProducto" layoutX="70.0" layoutY="55.0"/>
                        </children>
                    </AnchorPane>
                    <AnchorPane maxWidth="-Infinity" prefHeight="100.0" prefWidth="240.0"
                                style="-fx-border-color: #8B4513 transparent #8B4513  #8B4513; -fx-border-style: dashed;">
                        <children>
                            <RadioButton fx:id="rdbEAN13" layoutX="16.0" layoutY="45.0" mnemonicParsing="false"
                                         text="EAN13"/>
                            <RadioButton fx:id="rdbCodabar" layoutX="14.0" layoutY="18.0" mnemonicParsing="false"
                                         text="CODABAR"/>
                            <RadioButton fx:id="rdbCode128" layoutX="15.0" layoutY="76.0" mnemonicParsing="false"
                                         text="Code128"/>
                            <RadioButton fx:id="rdbUtc" layoutX="17.0" layoutY="109.0" mnemonicParsing="false"
                                         text="UTC-A"/>
                        </children>
                    </AnchorPane>
                    <AnchorPane maxWidth="-Infinity" prefHeight="100.0" prefWidth="240.0"
                                style="-fx-border-color: #8B4513 transparent #8B4513  #8B4513; -fx-border-style: dashed;">
                        <children>
                            <RadioButton fx:id="rdb80mm" layoutX="13.0" layoutY="16.0" mnemonicParsing="false"
                                         text="ticket80mm"/>
                            <RadioButton fx:id="rdb50mm" layoutX="13.0" layoutY="45.0" mnemonicParsing="false"
                                         text="Ticket58mm"/>
                            <RadioButton layoutX="13.0" layoutY="76.0" mnemonicParsing="false" text="Hoja Completa"/>
                            <RadioButton fx:id="rdbPrevisualizarSi" layoutX="13.0" layoutY="45.0"
                                         mnemonicParsing="false" text="previsulaizar"/>
                        </children>
                    </AnchorPane>
                    <AnchorPane maxWidth="-Infinity" prefHeight="100.0" prefWidth="240.0"
                                style="-fx-border-color: #8B4513 transparent #8B4513  #8B4513; -fx-border-style: dashed;">
                        <children>
                            <Button layoutX="142.0" layoutY="21.0" mnemonicParsing="false" onAction="#btnAgregarCodigo"
                                    text="Agregar"/>
                            <Button layoutX="141.0" layoutY="70.0" mnemonicParsing="false" onAction="#onImportarExcel"
                                    text="Excel"/>
                            <Label layoutX="19.0" layoutY="26.0" text="Agregar a Tabla:"/>
                            <Label layoutX="19.0" layoutY="76.0" text="Importar desde:"/>
                        </children>
                    </AnchorPane>
                </children>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tblCodigoBarras" prefHeight="232.0" prefWidth="662.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn maxWidth="50.0" minWidth="20.0" prefWidth="50.0" text="N#"/>
                <TableColumn maxWidth="500.0" prefWidth="-1.0" text="CODIGO"/>
                <TableColumn maxWidth="500.0" prefWidth="-1.0" text="PRODUCTO"/>
                <TableColumn maxWidth="500.0" prefWidth="-1.0" text="TIPO"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <cursor>
        <Cursor fx:constant="OPEN_HAND"/>
    </cursor>
</BorderPane>
